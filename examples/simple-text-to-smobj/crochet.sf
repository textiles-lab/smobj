#---- short row end face ----
face turn
	shorthand tu
	edge (-0.7,-1.0) -l1
	edge ( 0.7, 0.0) +l1
	edge (-0.7, 1.0) +ly1
	edge (-0.7, 0.0) -ly1

	yarn [0:0.275,0] (0.198702,-0.0168737,0) [1:0.725,0]
	yarn [0:0.725,0] (0.247722,-0.0121647,0) [1:0.275,0]
	yarn [3:0.75,0] (-0.148178,-0.144435,0.246504) [2:0.75,0]
	yarn [3:0.5,0] (-0.409264,0.1328,-0.250944) [2:0.5,0]
	yarn [3:0.2,0] (-0.130142,0.183334,0) [2:0.2,0]

face turn
	shorthand tu
	edge (-0.7,-1.0) -l2
	edge ( 0.7, 0.0) +l2
	edge (-0.7, 1.0) +ly1
	edge (-0.7, 0.0) -ly1

	yarn [0:0.275,0.1] (0.198702,-0.0168737,0.1) [1:0.725,0.1]
	yarn [0:0.725,0.1] (0.308924,-0.0121647,0.1) [1:0.275,0.1]
	yarn [0:0.275,-0.1] (0.0927687,-0.0168737,-0.1) [1:0.725,-0.1]
	yarn [0:0.725,-0.1] (0.191425,-0.0121647,-0.1) [1:0.275,-0.1]
	yarn [3:0.75,0] (-0.148178,-0.144435,0.246504) [2:0.75,0]
	yarn [3:0.5,0] (-0.409264,0.1328,-0.250944) [2:0.5,0]
	yarn [3:0.2,0] (-0.130142,0.183334,0) [2:0.2,0]


#derive turn -l1 -ly1 +ly1 +l1 by mirror-x from turn -l1 +l1 +ly1 -ly1
#derive turn -l2 -ly1 +ly1 +l2 by mirror-x from turn -l2 +l2 +ly1 -ly1

derive turn by mirror-x from turn -l1 +l1 +ly1 -ly1
derive turn by mirror-x from turn -l2 +l2 +ly1 -ly1


#---- simple "increase" face ---
face inc
	shorthand scinc
	edge (-1.0,-0.25) -l2
	edge ( 1.0,-0.25) +l2
	edge ( 0.0, 0.25) +l2

	yarn [0:0.275,-0.1] (-0.546872,-0.129914,-0.1) [2:0.725,-0.1]
	yarn [0:0.275,0.1] (-0.583794,-0.183728,0.1) [2:0.725,0.1]
	yarn [2:0.275,-0.1] (-1.49012e-08,-0.024876,-0.1) [1:0.725,-0.1]
	yarn [2:0.275,0.1] (-1.49012e-08,0.0531615,0.1) [1:0.725,0.1]
	yarn [1:0.275,-0.1] (0.560269,-0.143825,-0.1) [0:0.725,-0.1]
	yarn [1:0.275,0.1] (0.583516,-0.187842,0.1) [0:0.725,0.1]


face inc
	shorthand scinc
	edge (-1.0,-0.25) -l1
	edge ( 1.0,-0.25) +l1
	edge ( 0.0, 0.25) +l1

	yarn [0:0.275,0] (-0.570517,-0.164526,0) [2:0.725,0]
	yarn [2:0.275,0] (-1.49012e-08,0.024669,0) [1:0.725,0]
	yarn [1:0.275,0] (0.560269,-0.143825,0) [0:0.725,0]


#---- chain stitch ----
# no-loop-out version:
face ch-u+
	shorthand ch
	edge (-1.0,-1.0) x
	edge ( 1.0,-1.0) +ly
	edge ( 1.0, 1.0) x
	edge (-1.0, 1.0) -ly
