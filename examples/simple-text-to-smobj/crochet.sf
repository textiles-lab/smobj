#Crochet face types
#Edge formats:
# x (empty)
# at left and right have loop+yarn
# +ly (loop+yarn) [yarn at 0.25, loop at 0.5 & 0.8]
# -ly (loop+yarn) [yarn at 0.75, loop at 0.5 & 0.2]
# at top and bottom have loop stacks
# l0 (no loops, sometimes used instead of x because of the way flipping works)
# l1 (one loop)    [loop at 0.275, 0.725, z=0]
# l2 (two loops)   [z=-0.1, 0.1]
# l3 (three loops) [z=-0.2, 0.0, 0.2]


#---- "cap" for the top of a column of stitches ---
face cap
	shorthand cp
	edge (-1.0,-1.0) -l2
	edge ( 1.0,-1.0) x
	edge ( 1.0, 1.0) x
	edge (-1.0, 1.0) x

	yarn [0:0.275,-0.1] (-0.236868,-0.626648,-0.1) (0.224242,-0.645714,-0.1) [0:0.725,-0.1]
	yarn [0:0.275,0.1] (-0.223775,-0.731871,0.1) (0.292983,-0.735629,0.1) [0:0.725,0.1]



face cap
	shorthand cp
	edge (-1.0,-1.0) -l1
	edge ( 1.0,-1.0) x
	edge ( 1.0, 1.0) x
	edge (-1.0, 1.0) x

	yarn [0:0.275,0] (-0.210061,-0.636832,0) (0.273825,-0.658553,0) [0:0.725,0]

